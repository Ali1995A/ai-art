AIHUBMIX_API_KEY=your_api_key_here
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# Model name used in OpenAI-compatible Images API calls
AIHUBMIX_IMAGE_MODEL=doubao-seedream-4-5

# Image API mode:
# - (default) auto: use "predictions" API for Doubao/Seedream models
# - force predictions: set to "predictions"
AIHUBMIX_IMAGE_API=predictions

# Doubao size options: WIDTHxHEIGHT (e.g. 512x512) or 1k / 2k / 4k
# (speed-first recommended: 1k or 512x512)
AIHUBMIX_DOUBAO_SIZE=512x512
